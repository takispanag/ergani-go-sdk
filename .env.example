# Copy this file to .env and fill in your credentials. The .env file is
# ignored by git, so your credentials never end up in a commit.

# The Ergani username and password of the employer.
ERGANI_USERNAME=your-username
ERGANI_PASSWORD=your-password

# Optional. Defaults to the Ergani trial service.
ERGANI_BASE_URL=https://trialeservices.yeka.gr/WebServicesAPI/api
