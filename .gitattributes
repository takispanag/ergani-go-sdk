# Normalise line endings so that the repository, the working tree and the
# CI checkout are identical. Without this, a Windows checkout turns the
# sources into CRLF and `gofmt -l` reports every file as unformatted.
* text=auto eol=lf

*.go   text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.txt  text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
