                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:pattern value="([0-9]){9}" />
                        <xs:length value="9" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
			<xs:element name="f_start_date" nillable="false">
                <xs:annotation><xs:documentation>ΗΜ/ΝΙΑ ΕΝΑΡΞΗΣ</xs:documentation></xs:annotation>
