                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
			<xs:element name="f_afm_proswpoy" nillable="false">
				<xs:annotation>
					<xs:documentation>Νόμιμος Εκπρόσωπος(Α.Φ.Μ.)</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="([0-9]){9}" />
						<xs:length value="9" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="f_comments">
                <xs:annotation>
                    <xs:documentation>ΣΗΜΕΙΩΣΕΙΣ</xs:documentation>
                </xs:annotation>
                <xs:simpleType>
                    <xs:restriction base="xs:string">
                        <xs:maxLength value="100" />
                    </xs:restriction>
                </xs:simpleType>
            </xs:element>
			<xs:element name="f_file">
				<xs:annotation>
					<xs:documentation>ΕΠΙΣΥΝΑΠΤΟΜΕΝΟ ΑΡΧΕΙΟ ΕΝΤΥΠΟΥ:(pdf)</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:base64Binary">
					</xs:restriction>
				</xs:simpleType>
			</xs:element>

			<xs:element name="f_action" nillable="false">
				<xs:annotation>
					<xs:documentation>ΔΡΑΣΗ</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:maxLength value="500" />
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="DhlwseisVoluntaryStartType">
		<xs:sequence>
			<xs:element name="DhlwshVoluntaryStart" type="DhlwshVoluntaryStartType"  minOccurs="1"  maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>ΔΗΛΩΣΕΙΣ ΕΝΑΡΞΗΣ ΠΡΟΣΦΟΡΑΣ ΕΘΕΛΟΝΤΙΚΗΣ ΕΡΓΑΣΙΑΣ ΕΡΓΑΖΟΜΕΝΩΝ</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
    <xs:element name="DhlwseisVoluntaryStart" type="DhlwseisVoluntaryStartType">
		<xs:annotation>
			<xs:documentation>ΔΗΛΩΣΕΙΣ ΕΝΑΡΞΗΣ ΠΡΟΣΦΟΡΑΣ ΕΘΕΛΟΝΤΙΚΗΣ ΕΡΓΑΣΙΑΣ</xs:documentation>
		</xs:annotation>
	</xs:element>
